<idea-plugin>
  <id>io.runtimerocket</id>
  <name>RuntimeRocket</name>
  <vendor>RuntimeRocket</vendor>
  <description><![CDATA[
    Reload compiled JVM changes into a running application without a restart.
    Injects the RuntimeRocket agent on Application run configurations and
    connects over a loopback handshake. Spring Boot checkboxes load only when
    the optional Ultimate Spring Boot plugin is present.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.modules.lang</depends>
  <depends optional="true" config-file="rr-spring.xml">com.intellij.spring.boot</depends>
  <idea-version since-build="243" until-build="262.*"/>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="io.runtimerocket.plugin.RrStartupActivity"/>
    <java.programPatcher implementation="io.runtimerocket.plugin.run.RrJavaProgramPatcher"/>
    <notificationGroup id="RuntimeRocket" displayType="BALLOON"/>
    <projectConfigurable parentId="tools"
                         id="io.runtimerocket"
                         instance="io.runtimerocket.plugin.settings.RrConfigurable"
                         displayName="RuntimeRocket"/>
    <runConfigurationExtension implementation="io.runtimerocket.plugin.run.RrRunConfigurationExtension"/>
    <statusBarWidgetFactory id="RuntimeRocket"
                            implementation="io.runtimerocket.plugin.ui.RrStatusBarWidgetFactory"/>
    <toolWindow id="RuntimeRocket" anchor="bottom" icon="/icons/rr.svg"
                factoryClass="io.runtimerocket.plugin.ui.RrToolWindowFactory"/>
    <codeInsight.lineMarkerProvider language="JAVA"
                                    implementationClass="io.runtimerocket.plugin.ui.RrLastReloadLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider language="kotlin"
                                    implementationClass="io.runtimerocket.plugin.ui.RrLastReloadLineMarkerProvider"/>
    <editorNotificationProvider implementation="io.runtimerocket.plugin.ui.RrRestartEditorNotificationProvider"/>
  </extensions>

  <projectListeners>
    <listener class="io.runtimerocket.plugin.run.RrExecutionListener"
              topic="com.intellij.execution.ExecutionListener"/>
  </projectListeners>

  <actions>
    <action id="rr.reloadNow"
            class="io.runtimerocket.plugin.ui.ReloadNowAction"
            text="RuntimeRocket: Reload Now"
            description="Push last compile output to the agent">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="rr.toggle"
            class="io.runtimerocket.plugin.ui.ToggleRrAction"
            text="Enable RuntimeRocket on Run Configuration"
            description="Toggle RuntimeRocket on the selected run configuration"/>
    <action id="rr.attach"
            class="io.runtimerocket.plugin.run.AttachRuntimeRocketAction"
            text="Attach RuntimeRocket"
            description="Late-attach the RuntimeRocket agent to a running local JVM">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="rr.useBundledJbr"
            class="io.runtimerocket.plugin.run.UseBundledJbrAction"
            text="Use bundled JetBrains Runtime for this configuration"
            description="Set the selected run configuration JRE to bundled JetBrains Runtime after consent">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
